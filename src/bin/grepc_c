#!/bin/bash
#
# Copyright, the authors of the Linux man-pages project
# SPDX-License-Identifier: GPL-3.0-or-later

set -Eefuo pipefail;


# Defaults:
t='false';
t_e='false';
t_fp='false';
t_fd='false';
t_flp='false';
t_fld='false';
t_fgp='false';
t_fgd_libm='false';
t_fgd_libio='false';
t_mf='false';
t_mo='false';
t_t_braced='false';
t_t_td_simple='false';
t_t_td_braced='false';
t_t_td_func='false';
t_ue='false';
t_uf_def='false';
t_uf_linux_def='false';
t_umf='false';
t_umo='false';
t_ut_su='false';
t_ut_td_simple='false';


grepc_err()
{
	>&2 printf '%s\n' "$(basename "$0"): error: $*";
	exit 1;
}


while getopts "t:" opt; do
	case "$opt" in
	t)
		case "$OPTARG" in
		e)		t_e='true';		;;&
		f | fp)		t_fp='true';		;;&
		f | fd)		t_fd='true';		;;&
		f | fl | flp)	t_flp='true';		;;&
		f | fl | fld)	t_fld='true';		;;&
		f | fg | fgp)	t_fgp='true';		;;&
		f | fg | fgd)	t_fgd_libm='true';
				t_fgd_libio='true';	;;&
		m | mf)		t_mf='true';		;;&
		m | mo)		t_mo='true';		;;&
		t)		t_t_braced='true';
				t_t_td_simple='true';
				t_t_td_braced='true';
				t_t_td_func='true';	;;&
		u | ue)		t_ue='true';		;;&
		u | uf)		t_uf_def='true';
				t_uf_linux_def='true';	;;&
		u | um)		t_umf='true';
				t_umo='true';		;;&
		u | ut)		t_ut_su='true';
				t_ut_td_simple='true';	;;&
		[efmtu] | f[pdlg] | fl[pd] | fg[pd] | m[fo] | u[efmt])
				t='true';
				;;
		*)
				grepc_err "-$opt: $OPTARG: Unknown argument.";
				;;
		esac;
		;;
	\? | *)
		exit 1;
		;;
	esac;
done;
shift $((OPTIND-1));

if test $# -lt 1; then
	grepc_err "Missing identifier.";
fi;
identifier="$1";
shift;

if test $# -gt 0; then
	grepc_err "$1: Unexpected argument.";
fi;

if ! "$t"; then
	t_e='true';
	t_fp='true';
	t_fd='true';
	t_flp='true';
	t_fld='true';
	t_fgp='true';
	t_fgd_libm='true';
	t_fgd_libio='true';
	t_mf='true';
	t_mo='true';
	t_t_braced='true';
	t_t_td_simple='true';
	t_t_td_braced='true';
	t_t_td_func='true';
fi;


grepc_c_t_sue_decl_()   { printf '%s' '(?s)^(?:[\w[](?:[\w\s\(,\)[\]*]|::)*[\w\s\)*\]]\s+)?\b(?:'"$1"')\b[\w \t[\]:]*(?<!\w)'"$2"'(?!\w)'; }
grepc_c_f_return_()     { printf '%s' '(?s)^[\w[](?:[\w\s\(,\)[\]*]|::)+[\w\s\)*\]]\s+\**'; }
grepc_c_f_params_()     { printf '%s' '\s*(?<params>\((?:[\w\s,;[\]*\?:+-]|(?&params))*(?:\.\.\.)?\))'; }
grepc_c_f_decl_()       { grepc_c_f_return_;
                          printf '%s' '\(?'"$1"'\)?';
                          grepc_c_f_params_; }
grepc_c_body_()         { printf '%s' '[ \t]*\n*(?<space>[ \t]*){.*?^\k<space>}'; }
grepc_c_u_body_()       { printf '%s' '[ \t]*\n*(?<space>[ \t]*){(?:(?!^\k<space>?}).)*'"$1"'.*?^\k<space>}'; }
grepc_c_fld_decl_()     { printf '%s' '(?s)^(?:COMPAT_)?SYSCALL_DEFINE.\('"$1"'\b[\w\s,;[\]*\?:+-]*\)'; }
grepc_c_m_decl_()       { printf '%s' '(?s)^[ \t]*#\s*define\s[\s\\]*'"$1"'\b'; }
grepc_c_mf_decl_()      { grepc_c_m_decl_ "$1";
                          printf '%s' '\([^\(]*\)'; }
grepc_c_mo_decl_()      { grepc_c_m_decl_ "$1";
                          printf '%s' '(?!\()'; }
grepc_c_m_repl_()       { printf '%s' '(?:(?![^\\]$).)*'"$1"'.*?(?<!\\)$'; }


grepc_c_e()             { grepc_c_t_sue_decl_ 'enum' '';
                          grepc_c_u_body_ '^[ \t]*'"$1"'\b\s*[=,]';
                          echo '[^;]*;'; }
grepc_c_fp()            { grepc_c_f_decl_ "$1";
                          echo '(?:[\w\s\(,\)[\]]|::)*;'; }
grepc_c_fd()            { grepc_c_f_decl_ "$1";
                          grepc_c_body_;
                          echo; }
grepc_c_fgd_libm()      { grepc_c_fd "M_DECL_FUNC \(__$1\)"; }
grepc_c_fgd_libio()     { grepc_c_fd "_IO_$1"; }
grepc_c_fgp_libio()     { grepc_c_fp "_IO_$1"; }
grepc_c_fgp()           { grepc_c_fgp_libio "$1"; }
grepc_c_flp()           { grepc_c_fp "(?:compat_)?sys_$1"; }
grepc_c_fld()           { grepc_c_fld_decl_ "$1";
                          grepc_c_body_;
                          echo; }
grepc_c_mf()            { grepc_c_mf_decl_ "$1";
                          grepc_c_m_repl_ '';
                          echo; }
grepc_c_mo()            { grepc_c_mo_decl_ "$1";
                          grepc_c_m_repl_ '';
                          echo; }
grepc_c_t_braced()      { grepc_c_t_sue_decl_ 'struct|union|enum' "$1";
                          grepc_c_body_;
                          echo '[^;]*;'; }
grepc_c_t_td_simple()   { echo '(?s)^[ \t]*typedef\s+[^{};]+\b'"$1"';'; }
grepc_c_t_td_braced()   { printf '%s' '(?s)^[ \t]*typedef\s+(?:struct|union|enum)\b[\w \t[\]:]*';
                          grepc_c_body_;
                          echo '\s*'"$1"'(?:\[[\w\(,\)]\])*;'; }
grepc_c_t_td_func()     { echo '(?s)^[ \t]*typedef\s+[^{};]+\(\**'"$1"'\)\s*\([^{};]+;'; }
grepc_c_ue()            { grepc_c_t_sue_decl_ 'enum' '';
                          grepc_c_u_body_ "$1";
                          echo '[^;]*;'; }
grepc_c_uf_def()        { grepc_c_f_decl_ '\w+';
                          grepc_c_u_body_ "$1";
                          echo; }
grepc_c_uf_linux_def()  { grepc_c_fld_decl_ '\w+';
                          grepc_c_u_body_ "$1";
                          echo; }
grepc_c_umf()           { grepc_c_mf_decl_ '\w+'
                          grepc_c_m_repl_ "$1";
                          echo; }
grepc_c_umo()           { grepc_c_mo_decl_ '\w+'
                          grepc_c_m_repl_ "$1";
                          echo; }
grepc_c_ut_su()         { grepc_c_t_sue_decl_ 'struct|union' '';
                          grepc_c_u_body_ "$1";
                          echo '[^;]*;'; }
grepc_c_ut_td_simple()  { echo '(?s)^[ \t]*typedef\s+[^{};]*'"$1"'[^{};]+;'; }


if "$t_e";             then grepc_c_e "$identifier";             fi;
if "$t_fp";            then grepc_c_fp "$identifier";            fi;
if "$t_fd";            then grepc_c_fd "$identifier";            fi;
if "$t_flp";           then grepc_c_flp "$identifier";           fi;
if "$t_fld";           then grepc_c_fld "$identifier";           fi;
if "$t_fgp";           then grepc_c_fgp "$identifier";           fi;
if "$t_fgd_libm";      then grepc_c_fgd_libm "$identifier";      fi;
if "$t_fgd_libio";     then grepc_c_fgd_libio "$identifier";     fi;
if "$t_mf";            then grepc_c_mf "$identifier";            fi;
if "$t_mo";            then grepc_c_mo "$identifier";            fi;
if "$t_t_braced";      then grepc_c_t_braced "$identifier";      fi;
if "$t_t_td_simple";   then grepc_c_t_td_simple "$identifier";   fi;
if "$t_t_td_braced";   then grepc_c_t_td_braced "$identifier";   fi;
if "$t_t_td_func";     then grepc_c_t_td_func "$identifier";     fi;
if "$t_ue";            then grepc_c_ue "$identifier";            fi;
if "$t_uf_def";        then grepc_c_uf_def "$identifier";        fi;
if "$t_uf_linux_def";  then grepc_c_uf_linux_def "$identifier";  fi;
if "$t_umf";           then grepc_c_umf "$identifier";           fi;
if "$t_umo";           then grepc_c_umo "$identifier";           fi;
if "$t_ut_su";         then grepc_c_ut_su "$identifier";         fi;
if "$t_ut_td_simple";  then grepc_c_ut_td_simple "$identifier";  fi;
