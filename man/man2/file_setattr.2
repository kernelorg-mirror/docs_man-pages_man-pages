.TH file_setattr 2 (date) "Linux man-pages (unreleased)"
.SH NAME
file_setattr \- set filesystem file attributes
.SH SYNOPSIS
.nf
.BR "#include <linux/fcntl.h>" "      /* Definition of " AT_* " constants */"
.BR "#include <linux/fs.h>" "         /* Definition of " FS_XFLAG_* " constants */"
.BR "#include <sys/syscall.h>" "      /* Definition of " SYS_* " constants */"
.B #include <unistd.h>
.fi
.P
.nf
.B long\~syscall(SYS_file_setattr,
.BI "             int " dirfd ", const char *" path ,
.BI "             const struct file_attr *" fattr ", sizeof(struct file_attr),"
.BI "             unsigned int " flags );
.fi
.SH DESCRIPTION
The
.BR file_setattr ()
system call sets filesystem file attributes
on the file specified by path.
.P
The
.IR dirfd ,
.IR path ,
.IR flags ,
and size
arguments behave in the same way as in
.BR file_getattr (2).
.P
.I fattr
is an argument with
file attributes to set.
Programs should use
.BR file_getattr (2)
to initialize
.I fattr
before calling
.BR file_setattr ().
.SH RETURN VALUE
On success,
zero is returned.
On error,
\-1 is returned,
and
.I errno
is set to indicate the error.
.SH ERRORS
The errors are the same as returned by
.BR file_getattr (2)
with the addition of the following ones:
.TP
.B E2BIG
The size indicates a version which the kernel doesn't support
(the size is larger than the kernel expects)
and new fields are non-zero.
.TP
.B EINVAL
Invalid combination of parameters provided in
.I fattr
for this type of file or filesystem.
.TP
.B EPERM
The caller does not have the necessary permissions
to change the file attributes.
.TP
.B EROFS
The file is on a read-only filesystem.
.SH HISTORY
Linux 6.17.
.SH NOTES
This system call is designed to be extensible.
The size argument allows programs to indicate
which version of the
.I file_attr
structure they are using,
enabling the kernel to support both old and new versions
of the structure simultaneously.
.P
If the size
is smaller than the structure size the kernel expects,
the kernel treats the missing fields as having zero values
(which is a no-op).
If the size
is larger than expected,
the kernel checks that all unknown (to the kernel) fields are zero;
if not,
the call fails with
.BR E2BIG .
.SH EXAMPLES
The program below demonstrates the use of
.BR file_setattr ()
to set the
.B FS_XFLAG_NODUMP
flag on a file.
.SS Program source
.\" SRC BEGIN (file_setattr.c)
.EX
#define _GNU_SOURCE
#include <err.h>
#include <fcntl.h>
#include <linux/fs.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/syscall.h>
#include <unistd.h>
\&
int
main(int argc, char *argv[])
{
	int               dfd;
	struct file_attr  fa;
\&
	if (argc != 2) {
		fprintf(stderr, "Usage: %s <filename>\[rs]n", argv[0]);
		exit(EXIT_FAILURE);
	}
\&
	dfd = open(argv[1], O_RDONLY);
	if (dfd == \-1)
		err(EXIT_FAILURE, "open");
\&
	if (\-1 == syscall(SYS_file_getattr, dfd, "", &fa,
	                  sizeof(struct file_attr), AT_EMPTY_PATH))
	{
		err(EXIT_FAILURE, "file_getattr");
	}
\&
	printf("Current flags: 0x%w64x\[rs]n", fa.fa_xflags);
\&
	fa.fa_xflags |= FS_XFLAG_NODUMP;
\&
	if (\-1 == syscall(SYS_file_setattr, dfd, "", &fa,
	                  sizeof(struct file_attr), AT_EMPTY_PATH))
	{
		err(EXIT_FAILURE, "file_setattr");
	}
\&
	if (\-1 == syscall(SYS_file_getattr, dfd, "", &fa,
	                  sizeof(struct file_attr), AT_EMPTY_PATH))
	{
		err(EXIT_FAILURE, "file_getattr");
	}
\&
	if (fa.fa_xflags & FS_XFLAG_NODUMP)
		printf("flags 0x%w64x (NODUMP flag is set)\[rs]n", fa.fa_xflags);
\&
	exit(EXIT_SUCCESS);
}
.EE
.\" SRC END
.SH SEE ALSO
.BR file_getattr (2),
