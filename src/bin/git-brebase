#!/bin/bash
# Copyright 2026, Alejandro Colomar <alx@kernel.org>
# SPDX-License-Identifier: GPL-3.0-or-later

set -Eeufo pipefail;
shopt -s lastpipe;

err()
{
	>&2 printf '%s\n' "$(basename "$0"): error: $*";
	exit 1;
}

fp='';
other='';
while test $# -ge 1; do
	case "$1" in
	--first-parent)
		fp='--first-parent';
		;;
	--pre-exec=*)
		echo "$1" \
		| sed 's/--pre-exec=//' \
		| read -r pre;
		;;
	-*)
		other="$other $1";
		;;
	*)
		break;
		;;
	esac;
	shift;
done;
gbopts="$fp";
gropts="$other";

if test $# -lt 1; then
	err 'Missing target commit.';
fi;
if test $# -gt 1; then
	err 'Too many arguments.';
fi;
git rev-list -1 "$1" \
| read -r tgt;

# Try the target first.
while true; do  # once
	if test -v pre; then
		printf '%s' 'Pre-rebase exec: ';
		if
			$pre;
			x="$?";
			test "$x" -eq 0;
		then
			echo 'success';
		else
			echo "failure ($x)";
			break;
		fi;
	fi;

	# shellcheck disable=SC2086  # gropts may hold multiple options
	if git rebase $gropts "$tgt" >/dev/null 2>/dev/null; then
		echo 'Successfully rebased.';
	else
		echo 'Rebase: conflict';
		git rebase --abort >/dev/null;
		break;
	fi;
	exit 0;
done;

# Bisect.
git rev-parse --abbrev-ref HEAD \
| read -r branch;
# shellcheck disable=SC2248  # gbopts may hold multiple options
git bisect start $gbopts >/dev/null;
git bisect bad "$tgt" >/dev/null;
git merge-base HEAD "$tgt" \
| xargs -I{} git bisect good {};

while
	git bisect visualize --oneline \
	| wc -l \
	| xargs -I{} test {} -gt 1;
do
	git rev-list -1 HEAD \
	| read -r bisect_head;

	if test -v pre; then
		printf '%s' 'Pre-rebase exec: ';
		if
			$pre;
			x="$?";
			true;
		then
			case "$x" in
			0)
				echo 'success';
				;;
			125)
				echo 'skip';
				git bisect skip "$bisect_head";
				continue;
				;;
			*)
				echo "failure ($x)";
				git bisect bad "$bisect_head";
				continue;
				;;
			esac;
		fi;
	fi;

	git switch "$branch" >/dev/null 2>/dev/null;
	printf '%s' 'Rebase: ';
	# shellcheck disable=SC2086  # gropts may hold multiple options
	if git rebase $gropts "$bisect_head" >/dev/null 2>/dev/null; then
		echo 'success';
		git bisect good "$bisect_head";
	else
		echo 'conflict';
		git rebase --abort >/dev/null;
		git bisect bad "$bisect_head";
		continue;
	fi;
done;

git rev-list -1 bisect/bad \
| read -r bad;
git bisect reset >/dev/null 2>/dev/null;

# Perform the conflicting rebase
# shellcheck disable=SC2086  # gropts may hold multiple options
git rebase $gropts "$bad";
