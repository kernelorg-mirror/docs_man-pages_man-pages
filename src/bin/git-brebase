#!/bin/bash
# Copyright 2026, Alejandro Colomar <alx@kernel.org>
# SPDX-License-Identifier: GPL-3.0-or-later

set -Eeufo pipefail;
shopt -s lastpipe;

if test $# -lt 1; then
	>&2 printf '%s\n' "$(basename "$0"): error: Too few arguments."
	exit 1;
fi;

if test $# -gt 1; then
	>&2 printf '%s\n' "$(basename "$0"): error: Too many arguments."
	exit 1;
fi;

git rev-list -1 "$1" \
| read -r tgt;

## Try a regular rebase.
if
	git rebase "$tgt" >/dev/null 2>/dev/null;
	test $? -eq 0;
then
	echo 'Successfully rebased.';
	exit 0;
else
	echo 'Rebase: conflict';
	git rebase --abort >/dev/null;
fi;

## Bisect.
git rev-parse --abbrev-ref HEAD \
| read -r branch;
git bisect start >/dev/null;
git bisect bad "$tgt" >/dev/null;
git merge-base HEAD "$tgt" \
| xargs -I{} git bisect good {};

while
	git bisect visualize --oneline \
	| wc -l \
	| xargs -I{} test {} -gt 1;
do
	git rev-list -1 HEAD \
	| read -r tgt;
	git switch "$branch" >/dev/null 2>/dev/null;

	if
		git rebase "$tgt" >/dev/null 2>/dev/null;
		test $? -eq 0;
	then
		echo 'Rebase: success';
		git bisect good "$tgt";
	else
		echo 'Rebase: conflict';
		git rebase --abort >/dev/null;
		git bisect bad "$tgt";
	fi;
done;

git rev-list -1 bisect/bad \
| read -r tgt;
git bisect reset >/dev/null 2>/dev/null;

## Perform the conflicting rebase
git rebase "$tgt";
